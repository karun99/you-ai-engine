{
  "app": {
    "name": "perspective-ai",
    "version": "1.0.0",
    "description": "Perspective AI - Build and deploy AI-powered applications with a unique perspective"
  },
  "stack": "node",
  "routes": [
    {
      "method": "post",
      "path": "/api/auth/register"
    },
    {
      "method": "post",
      "path": "/api/auth/login"
    },
    {
      "method": "post",
      "path": "/api/projects"
    },
    {
      "method": "get",
      "path": "/api/projects"
    },
    {
      "method": "get",
      "path": "/api/projects/:id"
    },
    {
      "method": "post",
      "path": "/api/projects/:id/generate"
    },
    {
      "method": "get",
      "path": "/api/admin/stats"
    }
  ],
  "pages": [],
  "base_url": "http://localhost:3000",
  "module": null,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "server": "mcp-server/server.mjs",
  "runner": "node",
  "runner_cmd": "node"
}